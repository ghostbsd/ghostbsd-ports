[Desktop Entry]
Encoding=UTF-8
Name=Thunderbird
GenericName=Mail Client
Comment=Mail client and News Reader
Exec=@MOZILLA@ %u
Icon=@PORTNAME_ICON@
StartupNotify=true
Terminal=false
Type=Application
Categories=Network;Email;News;InstantMessaging;
MimeType=message/rfc822;x-scheme-handler/mailto;text/calendar;text/x-vcard;
