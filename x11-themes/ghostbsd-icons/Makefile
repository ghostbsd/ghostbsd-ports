PORTNAME=	ghostbsd-icons
PORTVERSION=	26.10.0
CATEGORIES=	x11-themes

MAINTAINER=	ericturgeon.bsd@gmail.com
COMMENT=	GhostBSD icons for GTK DE
WWW=		http://www.ghostbsd.org/

LICENSE=	CCBYSA
LICENSE_NAME=	CREATIVE COMMON
LICENSE_FILE=	${FILESDIR}/LICENSE
LICENSE_PERMS=	dist-mirror pkg-mirror auto-accept
LICENSE_DISTFILES=	${DISTNAME}${EXTRACT_SUFX}

USES=		gnome
USE_GNOME=	gtk-update-icon-cache
USE_GITHUB=	yes
GH_ACCOUNT=	GhostBSD

NO_BUILD=	yes

do-install:
	${MKDIR} ${STAGEDIR}${PREFIX}/share/icons/
	${CP} -R ${WRKSRC}/icons/* ${STAGEDIR}${PREFIX}/share/icons
	# icon caches are generated by the gtk-update-icon-cache trigger
	${FIND} ${STAGEDIR}${PREFIX}/share/icons -name icon-theme.cache -delete
	# copy the G logo into hicolor for the MATE panel, only the icon
	# directories so index.theme does not replace hicolor's
	${MKDIR} ${STAGEDIR}${PREFIX}/share/icons/hicolor
	cd ${WRKSRC}/icons/ghostbsd && ${CP} -R [0-9]*x[0-9]* scalable \
		${STAGEDIR}${PREFIX}/share/icons/hicolor

.include <bsd.port.mk>
